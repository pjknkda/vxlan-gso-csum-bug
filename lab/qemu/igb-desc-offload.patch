--- a/hw/net/igb_core.c
+++ b/hw/net/igb_core.c
@@ -473,6 +473,158 @@
         net_tx_pkt_setup_vlan_header_ex(tx->tx_pkt, vlan,
             core->mac[VET] & 0xffff);
     }
+    tx->vlan_inserted = insert_vlan;
+}
+
+/*
+ * Checksum/TSO offload driven by the advanced context descriptor, as the
+ * 82576 does it: L4 starts at MACLEN + IPLEN, the TSO header is
+ * MACLEN + IPLEN + L4LEN bytes, the IP header at MACLEN gets length/ID and
+ * a checksum over the whole IPLEN range, and the L4 checksum is completed
+ * from the pseudo-header seed the driver left in the checksum field.
+ *
+ * The generic net_tx_pkt path instead parses the frame itself and always
+ * offloads the *outermost* L4 header, which is wrong for encapsulated
+ * frames (Linux igb uses GSO_PARTIAL / CHECKSUM_PARTIAL on the inner one).
+ */
+static uint32_t igb_csum_add(uint32_t sum, const uint8_t *p, size_t len)
+{
+    size_t i;
+
+    for (i = 0; i + 1 < len; i += 2) {
+        sum += (p[i] << 8) | p[i + 1];
+    }
+    if (len & 1) {
+        sum += p[len - 1] << 8;
+    }
+    return sum;
+}
+
+static uint16_t igb_csum_fold(uint32_t sum)
+{
+    while (sum >> 16) {
+        sum = (sum & 0xffff) + (sum >> 16);
+    }
+    return ~sum & 0xffff;
+}
+
+static void igb_desc_l4_csum(uint8_t *frame, size_t len, size_t l4off,
+                             bool tcp)
+{
+    size_t field = l4off + (tcp ? 16 : 6);
+    uint16_t csum;
+
+    if (field + 2 > len) {
+        return;
+    }
+    /* The field holds the pseudo-header seed (without length for TSO). */
+    csum = igb_csum_fold(igb_csum_add(0, frame + l4off, len - l4off));
+    if (!tcp && csum == 0) {
+        csum = 0xffff;
+    }
+    stw_be_p(frame + field, csum);
+}
+
+static bool
+igb_tx_desc_offload_send(IGBCore *core, struct igb_tx *tx, NetClientState *nc)
+{
+    uint32_t idx = (tx->first_olinfo_status >> 4) & 1;
+    uint32_t lens = tx->ctx[idx].vlan_macip_lens;
+    uint32_t tucmd = tx->ctx[idx].type_tucmd_mlhl;
+    uint32_t mli = tx->ctx[idx].mss_l4len_idx;
+    size_t maclen = (lens >> E1000_ADVTXD_MACLEN_SHIFT) & 0x7f;
+    size_t iplen = lens & 0x1ff;
+    size_t total = net_tx_pkt_get_total_len(tx->tx_pkt);
+    bool tcp = tucmd & E1000_ADVTXD_TUCMD_L4T_TCP;
+    bool ipv4 = tucmd & E1000_ADVTXD_TUCMD_IPV4;
+    size_t l4off, hdrlen, paylen, mss, off;
+    uint8_t *frame, *seg;
+    uint16_t ipid;
+    uint32_t seq;
+    bool ok = true;
+
+    if (tx->vlan_inserted) {
+        maclen += sizeof(struct vlan_header);
+    }
+    l4off = maclen + iplen;
+
+    frame = g_malloc(total);
+    if (net_tx_pkt_copy_frame(tx->tx_pkt, frame, total) != total ||
+        l4off >= total) {
+        g_free(frame);
+        return false;
+    }
+
+    if (!(tx->first_cmd_type_len & E1000_ADVTXD_DCMD_TSE)) {
+        if (tx->first_olinfo_status & E1000_ADVTXD_POTS_IXSM && ipv4) {
+            size_t ihl = (frame[maclen] & 0xf) * 4;
+
+            stw_be_p(frame + maclen + 10, 0);
+            stw_be_p(frame + maclen + 10,
+                     igb_csum_fold(igb_csum_add(0, frame + maclen, ihl)));
+        }
+        if (tx->first_olinfo_status & E1000_ADVTXD_POTS_TXSM) {
+            igb_desc_l4_csum(frame, total, l4off, tcp);
+        }
+        ok = qemu_send_packet(nc, frame, total) >= 0;
+        g_free(frame);
+        return ok;
+    }
+
+    mss = mli >> E1000_ADVTXD_MSS_SHIFT;
+    hdrlen = l4off + ((mli >> E1000_ADVTXD_L4LEN_SHIFT) & 0xff);
+    if (!mss || hdrlen > total) {
+        g_free(frame);
+        return false;
+    }
+    paylen = total - hdrlen;
+    ipid = lduw_be_p(frame + maclen + 4);
+    seq = ldl_be_p(frame + l4off + 4);
+    seg = g_malloc(hdrlen + mss);
+
+    off = 0;
+    do {
+        size_t plen = MIN(mss, paylen - off);
+        size_t seglen = hdrlen + plen;
+        bool last = off + plen >= paylen;
+
+        memcpy(seg, frame, hdrlen);
+        memcpy(seg + hdrlen, frame + hdrlen + off, plen);
+
+        if (ipv4) {
+            /* Driver pre-cancels any bytes between IP header and IPLEN. */
+            stw_be_p(seg + maclen + 2, seglen - maclen);
+            stw_be_p(seg + maclen + 4, ipid++);
+            stw_be_p(seg + maclen + 10,
+                     igb_csum_fold(igb_csum_add(0, seg + maclen, iplen)));
+        } else {
+            stw_be_p(seg + maclen + 4, seglen - maclen - 40);
+        }
+
+        if (tcp) {
+            stl_be_p(seg + l4off + 4, seq + off);
+            if (!last) {
+                seg[l4off + 13] &= ~(0x01 | 0x08); /* FIN, PSH */
+            }
+        } else {
+            stw_be_p(seg + l4off + 4, seglen - l4off);
+        }
+        /* Seed has no length for TSO; add this segment's L4 length. */
+        stw_be_p(seg + l4off + (tcp ? 16 : 6),
+                 ~igb_csum_fold(lduw_be_p(seg + l4off + (tcp ? 16 : 6)) +
+                                (uint32_t)(seglen - l4off)) & 0xffff);
+        igb_desc_l4_csum(seg, seglen, l4off, tcp);
+
+        if (qemu_send_packet(nc, seg, seglen) < 0) {
+            ok = false;
+        }
+        off += plen;
+    } while (off < paylen);
+
+    e1000x_inc_reg_if_not_full(core->mac, TSCTC);
+    g_free(seg);
+    g_free(frame);
+    return ok;
 }
 
 static bool
