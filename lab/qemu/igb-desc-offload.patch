+        (core->mac[RCTL] & E1000_RCTL_LBM_MAC) != E1000_RCTL_LBM_MAC &&
+        !(core->mac[MRQC] & 1)) {
+        return igb_tx_desc_offload_send(core, tx, queue);
+    }
 
     if (!igb_setup_tx_offloads(core, tx)) {
         return false;
